	measure 'Total Jobs Created' =
			
			SUM(ai_company_adoption[jobs_created])
		formatString: 0
		lineageTag: 83fb548a-84ee-4ba9-bc46-4d9c094df001

	measure 'Total Jobs Displaced' =
			
			SUM(ai_company_adoption[jobs_displaced])
		formatString: 0
		lineageTag: b8c0a1ae-8107-49cb-8042-e4a8ac556bdf

	measure 'Net Jobs Impact' =
			
			[Total Jobs Created] - [Total Jobs Displaced]
		formatString: 0
		lineageTag: fe8e1a2f-0a21-46a8-81f5-8107fae283e1

	measure 'Total Reskilled Employees' =
			
			SUM(ai_company_adoption[reskilled_employees])
		formatString: 0
		lineageTag: 5f1c6382-30b9-418e-a8f5-c6c01834d8d4

