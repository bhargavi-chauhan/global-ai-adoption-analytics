table ai_company_adoption
	lineageTag: 70a6a929-ebf1-47c8-8fba-99a15a8d7b2f

	measure 'Avg AI Adoption' =
			
			AVERAGE(ai_company_adoption[ai_adoption_rate])
		lineageTag: 2aaab9c2-09dc-4c9e-904c-9ae56ab37c02

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Productivity Change' =
			
			AVERAGE(ai_company_adoption[productivity_change_percent])
		lineageTag: 560c1d71-52f3-462a-a5b1-9c87451a7950

		annotation PBI_FormatHint = {"isGeneralNumber":true}

